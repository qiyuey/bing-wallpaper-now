{
  "name": "bing-wallpaper-now",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "overrides": {
    "flat-cache@>=4.0.0 <5.0.0-0": "4.0.1",
    "micromark-util-character@>=2.0.0 <3.0.0-0": "2.1.1",
    "micromark-util-symbol@>=2.0.0 <3.0.0-0": "2.0.1",
    "micromark-util-types@>=2.0.0 <3.0.0-0": "2.0.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "npm run check:rust && npm run check:frontend && npm run lint:md",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:frontend": "npm run typecheck && npm run lint && npm run format:check && npm run test:frontend",
    "fix": "cargo fmt --manifest-path src-tauri/Cargo.toml && npm run lint:fix && npm run format && npm run lint:md:fix",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts/run-bash.mjs",
    "lint:fix": "oxlint src scripts/run-bash.mjs --fix",
    "lint:md": "markdownlint \"*.md\" \"docs/**/*.md\" --ignore node_modules --ignore src-tauri/target",
    "lint:md:fix": "markdownlint \"*.md\" \"docs/**/*.md\" --ignore node_modules --ignore src-tauri/target --fix",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,css}\" \"scripts/run-bash.mjs\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css}\" \"scripts/run-bash.mjs\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:frontend": "vitest run --pool=threads --maxWorkers=1",
    "test:e2e:web": "playwright test",
    "test:e2e:web:headed": "playwright test --headed",
    "test:e2e:web:install": "playwright install chromium",
    "test:notification:macos": "tauri build --debug --bundles app --config src-tauri/tauri.notification-test.conf.json && open \"src-tauri/target/debug/bundle/macos/Bing Wallpaper Now.app\"",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && vitest run",
    "package": "tauri build",
    "version:patch": "node scripts/run-bash.mjs scripts/manage-version.sh patch",
    "version:minor": "node scripts/run-bash.mjs scripts/manage-version.sh minor",
    "version:major": "node scripts/run-bash.mjs scripts/manage-version.sh major",
    "release": "node scripts/run-bash.mjs scripts/manage-version.sh release",
    "release:patch": "node scripts/run-bash.mjs scripts/manage-version.sh release patch",
    "release:minor": "node scripts/run-bash.mjs scripts/manage-version.sh release minor",
    "release:major": "node scripts/run-bash.mjs scripts/manage-version.sh release major",
    "retag": "node scripts/run-bash.mjs scripts/manage-version.sh retag",
    "icons": "node scripts/generate-icons.mjs",
    "test:browser": "vitest run --project=browser --coverage.enabled=false",
    "test:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.75.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  }
}
